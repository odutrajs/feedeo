# Copie para .env e preencha suas chaves
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...

# Voz personalizada (ID da voz clonada na ElevenLabs)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Modelos
OPENAI_TEXT_MODEL=gpt-4o
WHISPER_MODEL_SIZE=small

# Geração de imagens premium (fal.ai — FLUX.2 Pro)
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-2-pro

# MinIO (docker compose up -d na raiz). Deixe MINIO_ENDPOINT vazio para desativar.
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=creators
MINIO_SECRET_KEY=creators123
MINIO_BUCKET=creators-media

LOG_LEVEL=INFO

# Instagram OAuth (app Meta)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8005/api/auth/instagram/callback
PUBLIC_BASE_URL=
FRONTEND_URL=http://localhost:3001
